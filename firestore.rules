rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && (request.auth.uid == userId || userId == 'usr_default');
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow read, write: if true;
    }

    // Top-Level User Record & Nested Subcollections
    match /users/{userId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Profiles Collection (Backward compatibility)
    match /profiles/{userId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Top-Level AI Conversations & Chat History
    match /ai_conversations/{conversationId} {
      allow read, write: if true;
    }

    match /chat_history/{messageId} {
      allow read, write: if true;
    }

    match /activity_logs/{historyId} {
      allow read, write: if true;
    }

    // Top-Level Roadmaps & Journeys
    match /roadmaps/{roadmapId} {
      allow read, write: if true;
    }

    // Top-Level Documents
    match /documents/{docId} {
      allow read, write: if true;
    }

    // Top-Level Notifications
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // Government Services & Evidence
    match /governmentServices/{serviceId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    match /governmentEvidence/{evidenceId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /government_sources/{sourceId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /government_source_versions/{versionId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
